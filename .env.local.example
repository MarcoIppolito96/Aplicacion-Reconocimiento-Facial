APP_NAME=Facial Recognition TP1
# Modelo de embeddings elegido en 2-train.ipynb: ArcFace (InsightFace buffalo_l)
MODEL_NAME=w600k_r50.onnx
SIMILARITY_METRIC=cosine
# Umbral calibrado en validación para FAR = 1e-3 (ver 2-train.ipynb, sección 4.3)
SIMILARITY_THRESHOLD=0.243
EMBEDDINGS_PATH=data/embeddings.json
DATA_PATH=data
OUTPUT_PATH=output
# Orígenes permitidos para CORS (coma). Use * en desarrollo.
CORS_ORIGINS="http://localhost:8080"
MODEL_PATH=models
# Detector de rostros SCRFD (InsightFace buffalo_l), dentro de MODEL_PATH
DETECTOR_MODEL_NAME=det_10g.onnx
# Score mínimo de detección y tamaño de entrada del detector
DET_SCORE_THRESHOLD=0.5
DET_INPUT_SIZE=640
# Lado mínimo (px) de la caja para aceptar un rostro
MIN_FACE_SIZE=20
# Margen relativo alrededor de la caja al recortar para buscar landmarks
ALIGN_MARGIN=0.5
MAX_WORKERS=2
FACE_SIZE=112
# Dimensión del embedding de ArcFace
EMBEDDING_DIM=512

# PostgreSQL / pgvector
USE_PGVECTOR=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=faces
POSTGRES_USER=faces_user
POSTGRES_PASSWORD=faces_pass
